DATABASE_URL="postgresql://postgres:postgres@localhost:5432/saas_mstl?schema=public"
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET="generate-a-random-secret-before-running"

# Provedores sociais aparecem somente quando habilitados e com credenciais completas.
# Para alterar a disponibilidade, mude AUTH_*_ENABLED e reinicie/reimplante a aplicação.
AUTH_GOOGLE_ENABLED="false"
AUTH_GOOGLE_CLIENT_ID=""
AUTH_GOOGLE_CLIENT_SECRET=""
AUTH_GITHUB_ENABLED="false"
AUTH_GITHUB_CLIENT_ID=""
AUTH_GITHUB_CLIENT_SECRET=""
AUTH_FACEBOOK_ENABLED="false"
AUTH_FACEBOOK_CLIENT_ID=""
AUTH_FACEBOOK_CLIENT_SECRET=""
